#!/usr/bin/env elixir
# brief-check — check text an agent will read before it is shown to the Coordinator.
#
#   tools/brief-check op-NNN     check an op's brief (as `tools/rob show` prints it)
#   tools/brief-check FILE | -   check a cast, restart prompt or answer
#
# Arranger-only: the phrase lists below exist so that agents never see them
# (safety-flag-avoidance.md rule 6). FAIL lines must be fixed; WARN lines need a reason to stay.
# Exit 1 on any FAIL. Then read the text once as a whole (LOCAL.md § Before showing a brief).

defmodule BriefCheck do
  @context "Context: ordinary debugging and testing of our own open-source OS"

  # Topics that need the context sentence (safety-flag-avoidance.md rule 1).
  @needs_context ~r/\b(panic|crash|signal|SIG[A-Z]+|KASAN|KMSAN|sanitiz|fuzz|fail\(9\)|fault|assert|privilege|WITNESS)/i

  # Words never used (rule 4).
  @fail ~r/\b(exploit\w*|attack\w*|payload\w*|weaponi[sz]\w*|evade|evasion|escalat\w*|bypass\w*|inject\w*|poison\w*)\b/i

  # Phrasings that read like research into breaking code (rules 2 and 3, the word table, op-569).
  @warn [
    {~r/\bfuzz\w*/i, "generated-input testing"},
    {~r/\b(double[- ]free|use[- ]after[- ]free|overflow)\b/i, "keep only as a defect in our code at file:line"},
    {~r/\bfree[sd]? .{0,40}\btwice\b|\btwice\b.{0,40}\bfree/i, "say who releases it: the callee and the caller both release X"},
    {~r/\bfreed while\b|\bpoints? into (freed|unloaded)/i, "say what stays registered or referenced after unload"},
    {~r/\b(from|reach\w*|reachable) (from )?user ?space\b/i, "hard to trigger from a test program"},
    {~r/\bkernel pointers?\b.{0,60}\buser pointers?\b|\buser pointers?\b.{0,60}\bkernel pointers?\b/i,
     "the handler is written for a user address but receives a message field"},
    {~r/\b(hazard|zombie theft|steal\w*|abort launchd|attack surface|target(ed|ing)? (system|host|machine))\b/i,
     "see the word table"},
    {~r/\bsecurity\b|\bfilter(ed)? (stop|stopped)\b/i, "no talk of security or filters in agent text (rule 6)"}
  ]

  def main([arg]) do
    root = Path.expand("..", __DIR__)
    text = read(root, arg)
    lines = String.split(text, "\n")

    results =
      context(text) ++ pointers(root, lines) ++ words(lines, @fail, "FAIL", "never used") ++ warns(lines)

    Enum.each(results, &IO.puts/1)
    fails = Enum.count(results, &String.starts_with?(&1, "FAIL"))
    IO.puts("#{fails} FAIL, #{length(results) - fails} WARN. Now read it once as a whole: LOCAL.md § Before showing a brief.")
    if fails > 0, do: System.halt(1)
  end

  def main(_) do
    IO.puts(:stderr, "usage: tools/brief-check op-NNN | FILE | -")
    System.halt(2)
  end

  defp read(_root, "-"), do: IO.read(:stdio, :eof)

  defp read(root, "op-" <> _ = op) do
    {out, 0} = System.cmd(Path.join(root, "tools/rob"), ["show", op])
    out
  end

  defp read(_root, file), do: File.read!(file)

  defp context(text) do
    if Regex.match?(@needs_context, text) and not String.contains?(text, @context),
      do: ["FAIL context sentence missing (the text mentions crashes, signals, sanitizers or assertions)"],
      else: []
  end

  # Agents never read this repo: no path or file name from it (method.md § Wording; LOCAL.md).
  defp pointers(root, lines) do
    own =
      Path.wildcard(Path.join(root, "*.md"))
      |> Enum.map(&Path.basename/1)
      |> Kernel.--(["AGENTS.md", "LOCAL.md", "README.md"])

    pattern = ~r/rmx-arranger(?!\d)|\b(idq|l1i|doc\/activation)\/|\b(#{Enum.map_join(own, "|", &Regex.escape/1)})\b/

    words(lines, pattern, "FAIL", "points into the Arranger's repo; carry the content inline")
  end

  # Phrases wrap across lines, so match them on the text with whitespace collapsed.
  defp warns(lines) do
    flat = lines |> Enum.join(" ") |> String.replace(~r/\s+/, " ")

    for {re, hint} <- @warn, [{at, len} | _] <- Regex.scan(re, flat, return: :index) do
      from = max(at - 30, 0)
      "WARN \"#{binary_part(flat, at, len)}\": #{hint}\n    …#{binary_part(flat, from, min(len + 60, byte_size(flat) - from))}…"
    end
  end

  defp words(lines, re, level, hint) do
    for {line, n} <- Enum.with_index(lines, 1), m = Regex.run(re, line), m != nil do
      "#{level} line #{n}: \"#{hd(m)}\": #{hint}\n    #{String.trim(line)}"
    end
  end
end

BriefCheck.main(System.argv())
