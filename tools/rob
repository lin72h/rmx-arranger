#!/usr/bin/env elixir
# rob — op state for the Arranger workspace. Run `tools/rob` for usage.

defmodule Rob.Error do
  defexception [:message]
end

defmodule Rob do
  @usage """
  rob — op state for the Arranger workspace.

  Op files live at doc/activation/op-NNN[m]-activation.md. A converted file starts with a
  front-matter block; a legacy file carries its state in the prose header (`state: **[X]**`),
  which rob maps onto the current vocabulary. `rob set` converts a legacy file by prepending
  front matter and leaves the original header untouched below it.

    rob board                   live ops grouped by state (the Rule-13 board)
    rob list [STATE...]         one line per op, optionally filtered by state
    rob show OP [--raw]         the brief, ready to relay (--raw: the file as stored)
    rob set OP STATE [k=v...] [--force]
                                change state and optional fields; --force skips the
                                transition check (corrections only)
    rob new TITLE agent=.. repo=.. [k=v...]
                                create a draft op with the next free id
    rob next-id                 next free project op number
    rob check                   unknown states, dangling needs/idq/repo, stale issued/returned ops

  States and transitions: rob-mini-format.md. Brief format: op-brief-forms.md. Each role's
  defaults and REPORT block live in its repo's OPS.md, so briefs carry only op-specific parts.
  Tests: elixir tools/test/rob_test.exs
  """

  @states ~w(draft issued returned hold closed dropped)
  @live ~w(issued returned draft hold)
  @next %{
    "draft" => ~w(issued hold dropped),
    "issued" => ~w(returned dropped),
    "returned" => ~w(closed dropped),
    "hold" => ~w(draft dropped),
    "closed" => [],
    "dropped" => []
  }
  @stale_days %{"issued" => 14, "returned" => 7}
  # Ids through op-360 were used by chat-only ops that have no file here (j-20260927-008).
  @legacy_floor 360
  @fields ~w(id state agent repo idq needs gate authority updated)

  # Legacy header tags -> current state. Unknown tags are reported by `rob check`.
  @legacy %{
    "draft" => "draft", "ready" => "draft", "awaiting" => "draft",
    "exe" => "issued", "in" => "issued", "in-flight" => "issued", "air" => "issued",
    "queued" => "issued",
    "done" => "returned", "returned" => "returned", "partial" => "returned",
    "hold" => "hold", "held" => "hold", "deferred" => "hold",
    "retired" => "closed", "closed" => "closed",
    "flushed" => "dropped", "void" => "dropped", "rejected" => "dropped"
  }

  @brief_template """
  ## Outcome


  Defaults and the REPORT block: OPS.md in your repo.
  """

  @fm_re ~r/\A---\n(.*?)\n---\n/s
  @legacy_re ~r/state:\s*\**\s*\[?([A-Za-z-]+)/
  @file_re ~r/op-(\d{3,})(m?)-activation\.md$/

  defp root, do: __ENV__.file |> Path.expand() |> Path.dirname() |> Path.dirname()
  defp ops_dir, do: Path.join([root(), "doc", "activation"])
  defp idq_dir, do: Path.join(root(), "idq")
  defp workspace, do: Path.dirname(root())

  defp die(msg), do: raise(Rob.Error, msg)

  defp stamp, do: Calendar.strftime(DateTime.utc_now(), "%Y-%m-%dT%H:%MZ")

  defp op_key(id) do
    case Regex.run(~r/^op-(\d+)(m?)$/, id) do
      [_, n, m] -> {m, String.to_integer(n)}
      _ -> {"z", 0}
    end
  end

  defp sorted(ids), do: Enum.sort_by(ids, &op_key/1)
  defp or_default(value, default), do: if(value in [nil, ""], do: default, else: value)

  # Front-matter fields are an ordered list of {key, value}, so rewrites keep their order.
  defp fget(fields, k), do: fields |> List.keyfind(k, 0, {k, nil}) |> elem(1)

  defp fput(fields, k, v) do
    if List.keymember?(fields, k, 0),
      do: List.keyreplace(fields, k, 0, {k, v}),
      else: fields ++ [{k, v}]
  end

  defp parse(path) do
    [_, num, m] = Regex.run(@file_re, Path.basename(path))
    text = File.read!(path)
    id = "op-#{num}#{m}"

    op =
      case Regex.run(@fm_re, text, return: :index) do
        [{0, len}, {s, l}] ->
          fields =
            text
            |> binary_part(s, l)
            |> String.split("\n")
            |> Enum.flat_map(fn line ->
              case String.split(line, ":", parts: 2) do
                [k, v] -> [{String.trim(k), String.trim(v)}]
                _ -> []
              end
            end)

          state = fget(fields, "state") || ""

          %{fields: fields, converted: true, state: state, raw: state,
            body: binary_part(text, len, byte_size(text) - len)}

        _ ->
          head = text |> String.split("\n") |> Enum.take(15) |> Enum.join("\n")

          raw =
            case Regex.run(@legacy_re, head) do
              [_, r] -> r
              _ -> ""
            end

          key = String.downcase(raw)
          state = Map.get(@legacy, key) || Map.get(@legacy, hd(String.split(key, "-")), "")
          %{fields: [], converted: false, state: state, raw: raw, body: text}
      end

    title =
      op.body
      |> String.split("\n")
      |> Enum.find("# " <> id, &String.starts_with?(&1, "# "))
      |> String.slice(2..-1//1)
      |> String.split(" — ", parts: 2)
      |> List.last()
      |> String.trim()

    Map.merge(op, %{path: path, id: id, text: text, title: title})
  end

  defp needs(op) do
    Regex.replace(~r/^[\[\] ]+|[\[\] ]+$/, fget(op.fields, "needs") || "", "")
    |> String.split(",")
    |> Enum.map(&String.trim/1)
    |> Enum.reject(&(&1 == ""))
  end

  defp age_days(op) do
    with u when is_binary(u) <- fget(op.fields, "updated"),
         {:ok, t, _} <- DateTime.from_iso8601(String.replace_suffix(u, "Z", ":00Z")) do
      div(DateTime.diff(DateTime.utc_now(), t), 86_400)
    else
      _ -> nil
    end
  end

  defp load do
    Path.join(ops_dir(), "op-*-activation.md")
    |> Path.wildcard()
    |> Enum.filter(&Regex.match?(@file_re, Path.basename(&1)))
    |> Map.new(fn p ->
      op = parse(p)
      {op.id, op}
    end)
  end

  defp get(ops, name) do
    name = if String.starts_with?(name, "op-"), do: name, else: "op-" <> name
    Map.get(ops, name) || die("no such op: #{name}")
  end

  defp parse_kv(args) do
    Enum.map(args, fn a ->
      case String.split(a, "=", parts: 2) do
        [k, v] -> {k, v}
        _ -> die("expected key=value, got #{inspect(a)}")
      end
    end)
  end

  defp render_fm(fields) do
    known = for k <- @fields, v <- [fget(fields, k)], v != nil, do: "#{k}: #{v}"
    other = for {k, v} <- fields, k not in @fields, do: "#{k}: #{v}"
    Enum.join(["---"] ++ known ++ other ++ ["---", ""], "\n")
  end

  def board(ops, _) do
    groups = Enum.group_by(Map.values(ops), & &1.state, & &1.id)

    lines =
      for s <- @live, ids <- [Map.get(groups, s, [])], ids != [],
          do: "- [#{s}]: " <> Enum.join(sorted(ids), ", ")

    unknown = for {s, ids} <- groups, s not in @states, id <- ids, do: id

    lines =
      if unknown == [],
        do: lines,
        else: lines ++ ["- [unknown]: " <> Enum.join(sorted(unknown), ", ") <> "  (run rob check)"]

    IO.puts(if lines == [], do: "(no live ops)", else: Enum.join(lines, "\n"))
  end

  def list(ops, want) do
    for op <- Enum.sort_by(Map.values(ops), &op_key(&1.id)), want == [] or op.state in want do
      legacy = if op.converted, do: "", else: " (legacy [#{or_default(op.raw, "?")}])"
      agent = if a = fget(op.fields, "agent"), do: " " <> a, else: ""
      IO.puts("#{op.id} [#{or_default(op.state, "unknown")}]#{legacy}#{agent} — #{String.slice(op.title, 0, 90)}")
    end
  end

  def show(ops, args) do
    case args -- ["--raw"] do
      [name] ->
        op = get(ops, name)

        if "--raw" in args or not op.converted do
          IO.write(op.text)
        else
          f = op.fields

          head =
            ["agent: #{fget(f, "agent") || "?"}", "repo: #{fget(f, "repo") || "?"}"] ++
              for(k <- ~w(idq needs authority), v <- [fget(f, k)], v not in [nil, ""], do: "#{k}: #{v}")

          lines = String.split(op.body, ~r/(?<=\n)/)

          case Enum.find_index(lines, &String.starts_with?(&1, "# ")) do
            nil ->
              IO.write(Enum.join(head, " | ") <> "\n\n" <> op.body)

            i ->
              {before, rest} = Enum.split(lines, i + 1)
              IO.write(Enum.join(before) <> Enum.join(head, " | ") <> "\n" <> Enum.join(rest))
          end
        end

      _ ->
        die("usage: rob show OP [--raw]")
    end
  end

  def set(ops, args) do
    case args -- ["--force"] do
      [name, state | kv] ->
        op = get(ops, name)
        state in @states || die("state must be one of #{Enum.join(@states, ", ")}")

        if "--force" not in args and state != op.state do
          case Map.fetch(@next, op.state) do
            :error ->
              die("#{op.id} has unknown state [#{or_default(op.raw, "none")}]; use --force to set it")

            {:ok, allowed} ->
              nxt = if allowed == [], do: "nothing (terminal)", else: Enum.join(Enum.sort(allowed), ", ")

              state in allowed ||
                die("#{op.id}: #{op.state} -> #{state} is not allowed (next: #{nxt}); --force for corrections")
          end
        end

        fields = if op.converted, do: op.fields, else: [{"id", op.id}]
        fields = if not op.converted and op.raw != "", do: fput(fields, "legacy-state", op.raw), else: fields
        fields = Enum.reduce(parse_kv(kv), fields, fn {k, v}, acc -> fput(acc, k, v) end)
        fields = fields |> fput("state", state) |> fput("updated", stamp())
        File.write!(op.path, render_fm(fields) <> op.body)
        IO.puts("#{op.id}: #{or_default(op.state, or_default(op.raw, "unknown"))} -> #{state}")

      _ ->
        die("usage: rob set OP STATE [key=value ...] [--force]")
    end
  end

  # Next id above every op file and above @legacy_floor. Prose mentions never reserve ids.
  defp next_id do
    Path.join(ops_dir(), "op-*-activation.md")
    |> Path.wildcard()
    |> Enum.flat_map(fn p ->
      case Regex.run(@file_re, Path.basename(p)) do
        [_, n, ""] -> [String.to_integer(n)]
        _ -> []
      end
    end)
    |> Enum.max(fn -> 0 end)
    |> max(@legacy_floor)
    |> Kernel.+(1)
  end

  defp fmt_id(n), do: "op-" <> String.pad_leading(Integer.to_string(n), 3, "0")

  def next_id_cmd(_, _), do: IO.puts(fmt_id(next_id()))

  def new(_, [title | rest]) do
    kv = parse_kv(rest)

    for k <- ~w(agent repo), not List.keymember?(kv, k, 0),
        do: die("#{k}= is required (name the owning agent and the exact repo)")

    oid = fmt_id(next_id())
    path = Path.join(ops_dir(), "#{oid}-activation.md")
    if File.exists?(path), do: die("#{path} exists")
    fields = [{"id", oid}, {"state", "draft"}] ++ kv ++ [{"updated", stamp()}]
    File.write!(path, render_fm(fields) <> "# #{oid} — #{title}\n\n" <> @brief_template)
    IO.puts(Path.relative_to(path, root()))
  end

  def new(_, _), do: die("usage: rob new TITLE agent=... repo=... [key=value ...]")

  defp idq_exists?(ref) do
    case Regex.run(~r/^(id-\d{3,})\b/, ref) do
      [_, id] -> Path.wildcard(Path.join(idq_dir(), "#{id}*.md")) != []
      _ -> false
    end
  end

  defp issues(op, ops) do
    base =
      cond do
        op.state == "" -> ["unknown state [#{or_default(op.raw, "none")}]"]
        op.converted and op.state not in @states -> ["invalid state #{inspect(op.state)}"]
        true -> []
      end

    if op.converted, do: base ++ field_issues(op, ops), else: base
  end

  defp field_issues(op, ops) do
    f = op.fields
    active = op.state in ~w(draft issued)
    missing = for k <- ~w(agent repo), active, fget(f, k) == nil, do: "missing #{k}"

    dangling =
      for n <- needs(op),
          msg <-
            [
              cond do
                not Map.has_key?(ops, n) -> "needs unknown #{n}"
                ops[n].state == "dropped" and op.state in @live -> "needs dropped #{n}"
                true -> nil
              end
            ],
          msg != nil,
          do: msg

    repo = (fget(f, "repo") || "") |> String.split(" ") |> hd()

    # A repo on another host is written host:/path and is not checked from here.
    repo_issue =
      if repo != "" and active and not String.match?(repo, ~r/^[^\/:]+:\//) and
           not File.exists?(Path.join(workspace(), repo)),
        do: ["repo #{repo} not found in #{workspace()}"],
        else: []

    ref = fget(f, "idq") || ""

    idq_issue =
      if ref != "" and not String.starts_with?(ref, "none") and not idq_exists?(ref),
        do: ["idq #{ref} has no file"],
        else: []

    stale =
      case {Map.get(@stale_days, op.state), age_days(op)} do
        {limit, age} when is_integer(limit) and is_integer(age) and age > limit ->
          ["#{op.state} #{age} days ago with no progress"]

        _ ->
          []
      end

    missing ++ dangling ++ repo_issue ++ idq_issue ++ stale
  end

  def check(ops, _) do
    flagged =
      for op <- Enum.sort_by(Map.values(ops), &op_key(&1.id)), found <- [issues(op, ops)], found != [] do
        IO.puts("#{op.id}: " <> Enum.join(found, "; "))
        op.id
      end

    legacy = Enum.count(Map.values(ops), &(not &1.converted))
    IO.puts("#{map_size(ops)} ops, #{legacy} legacy headers, #{length(flagged)} with problems")
    if flagged == [], do: 0, else: 1
  end

  @commands %{"board" => :board, "list" => :list, "show" => :show, "set" => :set,
              "new" => :new, "next-id" => :next_id_cmd, "check" => :check}

  def main([cmd | args]) when is_map_key(@commands, cmd) do
    code =
      try do
        case apply(__MODULE__, @commands[cmd], [load(), args]) do
          n when is_integer(n) -> n
          _ -> 0
        end
      rescue
        e in Rob.Error ->
          IO.puts(:stderr, "rob: " <> e.message)
          1
      end

    System.halt(code)
  end

  def main(_) do
    IO.puts(:stderr, @usage)
    System.halt(1)
  end
end

Rob.main(System.argv())
