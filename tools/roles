#!/usr/bin/env elixir
# roles — render role instances from their templates. Run `tools/roles` for usage.

defmodule Roles.Error do
  defexception [:message]
end

defmodule Roles do
  @usage """
  roles — render role instances from their templates.

  Every role is a class with a template and instances. A role with one instance is one repo,
  `rmx-<role>`, with its template inside it in `<role>0/`; a role with several instances has a
  template repo `rmx-<role>0` and numbered instances `rmx-<role>N`. Templates chain to a root,
  `rmx-role0`. A template is a directory with `template.json` ({"parent", "vars", "blocks"}),
  `files/` (rendered into each instance), and `partials/`. An instance repo holds `instance.json`
  ({"class", "vars", "blocks"}: its overrides only), the rendered files (never edited in place),
  `LOCAL.md` (its agent's own notes), and `.rendered.lock` (digests of what was rendered, so
  local edits are never overwritten). A "comment" key in either JSON file is ignored.

    roles list                          instances, their template chain, and render status
    roles diff INSTANCE                 what `render` would change
    roles render INSTANCE... [--adopt] [--force]
                                        write rendered files; --adopt takes over existing files
                                        once, --force overwrites local edits (both are rare)
    roles check                         exit 1 if any instance is stale, has local edits, or is
                                        a remote mirror not yet synced
    roles sync INSTANCE... [--adopt] [--force]
                                        copy a remote instance's rendered files from its local
                                        mirror to the host in its "remote" ("host:/path"); never
                                        overwrites the remote LOCAL.md

  INSTANCE is a folder name such as rmx-arranger or rmx-validator1, or `all`.

  An instance on another host has "remote" in its instance.json; its folder here is the
  Arranger's mirror. Render into the mirror, then `sync`. Extra ssh options come from the
  ROLES_SSH_OPTS environment variable. `sync` refuses to overwrite a rendered file that was
  edited on the remote since the last sync (`--force` overrides) or that it never synced
  (`--adopt` takes it over once).

  Template syntax, applied in this order:
    {{> name}}                          include partials/name.md (most derived template first)
    {{#block name}}default{{/block}}    a block; template.json or instance.json may override it
                                        under "blocks", and {{super}} inserts the overridden text
    {{var}}                             a variable from "vars"; built-ins: instance (folder), id
                                        (arranger, validator2), n (1 for a singleton), class, and
                                        template (the template's path relative to the instance)

  Tests: elixir tools/test/roles_test.exs
  """

  @lock ".rendered.lock"
  @synced ".synced.json"
  @local_stub """
  # LOCAL.md — notes for this instance

  This file is yours. Keep notes and lessons specific to this instance here; rendered files are
  regenerated from the role template and must not be edited. The Arranger reads this file and may
  promote a lesson into the template so every instance gets it.
  """

  @include_re ~r/\{\{>\s*([A-Za-z0-9_-]+)\s*\}\}/
  @block_re ~r/\{\{#block\s+([A-Za-z0-9_]+)\s*\}\}(.*?)\{\{\/block\}\}/s
  @var_re ~r/\{\{\s*([A-Za-z_][A-Za-z0-9_]*)\s*\}\}/

  defp die(msg), do: raise(Roles.Error, msg)

  defp workspace do
    System.get_env("ROLES_WORKSPACE") ||
      __ENV__.file |> Path.expand() |> Path.dirname() |> Path.dirname() |> Path.dirname()
  end

  defp sha(text), do: :crypto.hash(:sha256, text) |> Base.encode16(case: :lower)

  defp load_json(path) do
    with {:ok, text} <- File.read(path),
         {:ok, data} when is_map(data) <- JSON.decode(text) do
      data
    else
      {:ok, _} -> die("#{path}: expected a JSON object")
      {:error, reason} -> die("#{path}: #{inspect(reason)}")
    end
  end

  # Relative path from `base` to `target`, like Python's os.path.relpath.
  defp relpath(target, base) do
    t = Path.split(Path.expand(target))
    b = Path.split(Path.expand(base))
    common = Enum.zip(t, b) |> Enum.take_while(fn {x, y} -> x == y end) |> length()

    case List.duplicate("..", length(b) - common) ++ Enum.drop(t, common) do
      [] -> "."
      parts -> Path.join(parts)
    end
  end

  defp same_dir_id(dir) do
    {:ok, st} = File.stat(dir)
    {st.major_device, st.minor_device, st.inode}
  end

  # rmx-<cls> for the root and for roles with several instances; rmx-<role>/<cls> inside a
  # singleton role's repo.
  defp template_dir(cls) do
    role = String.replace_suffix(cls, "0", "")
    ws = workspace()

    found =
      [Path.join(ws, "rmx-#{cls}"), Path.join([ws, "rmx-#{role}", cls])]
      |> Enum.filter(&File.regular?(Path.join(&1, "template.json")))
      |> Enum.uniq_by(&same_dir_id/1)

    case found do
      [d] -> d
      [] -> die("template #{cls}: no rmx-#{cls}/template.json or rmx-#{role}/#{cls}/template.json")
      _ -> die("template #{cls}: found in more than one place: #{Enum.join(found, ", ")}")
    end
  end

  # Least-derived first: [root template, ..., class template, instance].
  defp chain_for(instance_dir) do
    inst = load_json(Path.join(instance_dir, "instance.json"))
    cls = inst["class"] || die("#{instance_dir}/instance.json: missing class")
    {chain, _} = walk(cls, [], MapSet.new())

    instance = %{name: Path.basename(instance_dir), dir: instance_dir, instance: true,
                 vars: inst["vars"] || %{}, blocks: inst["blocks"] || %{}}

    {cls, chain ++ [instance]}
  end

  defp walk(nil, chain, seen), do: {chain, seen}

  defp walk(cls, chain, seen) do
    if MapSet.member?(seen, cls), do: die("template cycle at #{cls}")
    dir = template_dir(cls)
    t = load_json(Path.join(dir, "template.json"))
    entry = %{name: cls, dir: dir, instance: false, vars: t["vars"] || %{}, blocks: t["blocks"] || %{}}
    walk(t["parent"], [entry | chain], MapSet.put(seen, cls))
  end

  defp builtins(instance_dir, cls, class_dir) do
    id = instance_dir |> Path.basename() |> String.replace_prefix("rmx-", "")

    n =
      case Regex.run(~r/(\d+)$/, id) do
        [_, d] -> d
        _ -> "1"
      end

    %{"instance" => Path.basename(instance_dir), "id" => id, "n" => n, "class" => cls,
      "template" => relpath(class_dir, instance_dir) <> "/"}
  end

  defp render_text(_text, _chain, _vars, where, depth) when depth > 10,
    do: die("#{where}: includes nested too deeply")

  defp render_text(text, chain, vars, where, depth) do
    text =
      Regex.replace(@include_re, text, fn _, name ->
        partial =
          chain
          |> Enum.reverse()
          |> Enum.reject(& &1.instance)
          |> Enum.map(&Path.join([&1.dir, "partials", name <> ".md"]))
          |> Enum.find(&File.regular?/1) || die("#{where}: no partial named #{inspect(name)}")

        partial |> File.read!() |> String.trim_trailing("\n") |> render_text(chain, vars, partial, depth + 1)
      end)

    text =
      Regex.replace(@block_re, text, fn _, name, default ->
        Enum.reduce(chain, default, fn t, acc ->
          case t.blocks[name] do
            nil -> acc
            override -> String.replace(override, "{{super}}", acc)
          end
        end)
      end)

    text =
      Regex.replace(@var_re, text, fn _, name ->
        case Map.fetch(vars, name) do
          {:ok, v} -> to_string(v)
          :error -> die("#{where}: unknown variable {{#{name}}}")
        end
      end)

    for marker <- ["{{#block", "{{/block}}", "{{>"], String.contains?(text, marker),
        do: die("#{where}: unmatched #{marker}")

    text
  end

  defp outputs(instance_dir) do
    {cls, chain} = chain_for(instance_dir)
    [class_template | _] = chain |> Enum.reject(& &1.instance) |> Enum.reverse()
    vars = chain |> Enum.map(& &1.vars) |> Enum.reduce(%{}, &Map.merge(&2, &1))
    vars = Map.merge(vars, builtins(instance_dir, cls, class_template.dir))

    files =
      for t <- chain, not t.instance, root <- [Path.join(t.dir, "files")], File.dir?(root),
          p <- Path.wildcard(Path.join(root, "**/*"), match_dot: true), File.regular?(p),
          into: %{},
          do: {Path.relative_to(p, root), p}

    out =
      for {rel, p} <- Enum.sort(files) do
        body = render_text(File.read!(p), chain, vars, p, 0)

        body =
          if String.ends_with?(rel, ".md"),
            do: "<!-- Rendered by the Arranger from the #{cls} template for #{vars["id"]}. " <>
                  "Do not edit; keep your own notes in LOCAL.md. -->\n" <> body,
            else: body

        {rel, body}
      end

    {cls, chain, out}
  end

  defp read_lock(instance_dir) do
    path = Path.join(instance_dir, @lock)
    if File.regular?(path), do: load_json(path), else: %{"files" => %{}}
  end

  # {cls, chain, out, stale, drifted, unmanaged}: paths needing work, by kind.
  defp status(instance_dir) do
    {cls, chain, out} = outputs(instance_dir)
    locked = read_lock(instance_dir)["files"] || %{}

    kinds =
      for {rel, body} <- out do
        path = Path.join(instance_dir, rel)
        current = if File.regular?(path), do: File.read!(path), else: nil

        kind =
          cond do
            Map.has_key?(locked, rel) and current != nil and sha(current) != locked[rel] -> :drifted
            Map.has_key?(locked, rel) -> if current != body, do: :stale, else: nil
            current == nil -> :stale
            current != body -> :unmanaged
            true -> nil
          end

        {kind, rel}
      end

    pick = fn k -> for {^k, rel} <- kinds, do: rel end
    {cls, chain, out, pick.(:stale), pick.(:drifted), pick.(:unmanaged)}
  end

  # Content digest of a template (template.json, files/, partials/): what was rendered from.
  defp digest_of(dir) do
    dir
    |> Path.join("**/*")
    |> Path.wildcard(match_dot: true)
    |> Enum.filter(&File.regular?/1)
    |> Enum.map(&{Path.relative_to(&1, dir), &1})
    |> Enum.filter(fn {rel, _} ->
      rel == "template.json" or hd(Path.split(rel)) in ["files", "partials"]
    end)
    |> Enum.sort()
    |> Enum.reduce(:crypto.hash_init(:sha256), fn {rel, p}, h ->
      :crypto.hash_update(h, [rel, 0, File.read!(p), 0])
    end)
    |> :crypto.hash_final()
    |> Base.encode16(case: :lower)
  end

  # Stable, readable JSON: sorted keys, two-space indent.
  defp pretty(value, indent \\ 0)

  defp pretty(map, _indent) when is_map(map) and map_size(map) == 0, do: "{}"

  defp pretty(map, indent) when is_map(map) do
    pad = String.duplicate("  ", indent + 1)
    items = for {k, v} <- Enum.sort(map), do: pad <> JSON.encode!(k) <> ": " <> pretty(v, indent + 1)
    "{\n" <> Enum.join(items, ",\n") <> "\n" <> String.duplicate("  ", indent) <> "}"
  end

  defp pretty([], _), do: "[]"

  defp pretty(list, indent) when is_list(list) do
    pad = String.duplicate("  ", indent + 1)
    items = for v <- list, do: pad <> pretty(v, indent + 1)
    "[\n" <> Enum.join(items, ",\n") <> "\n" <> String.duplicate("  ", indent) <> "]"
  end

  defp pretty(other, _), do: JSON.encode!(other)

  defp instances(["all"]) do
    ws = workspace()

    ws
    |> Path.join("rmx-*/instance.json")
    |> Path.wildcard()
    |> Enum.map(&Path.dirname/1)
    |> Enum.reject(fn d -> match?({:ok, %File.Stat{type: :symlink}}, File.lstat(d)) end)
    |> Enum.sort()
  end

  defp instances(names) do
    for a <- names do
      d = Path.join(workspace(), a)
      File.regular?(Path.join(d, "instance.json")) || die("#{a}: not an instance (no instance.json)")
      d
    end
  end

  def list(_args) do
    for d <- instances(["all"]) do
      {_cls, chain, out, stale, drifted, unmanaged} = status(d)
      names = Enum.map_join(chain, " -> ", & &1.name)

      pending = unsynced(d)

      state =
        cond do
          drifted != [] -> "local edits: " <> Enum.join(drifted, ", ")
          pending != [] and stale == [] and unmanaged == [] -> "not synced to #{remote_of(d)}: " <> Enum.join(pending, ", ")
          unmanaged != [] -> "unmanaged: " <> Enum.join(unmanaged, ", ")
          stale != [] -> "stale: " <> Enum.join(stale, ", ")
          true -> "up to date"
        end

      IO.puts("#{Path.basename(d)}: #{names} | #{length(out)} files | #{state}")
    end

    0
  end

  def diff([name]) do
    [d] = instances([name])
    {_, _, out} = outputs(d)
    tmp = Path.join(System.tmp_dir!(), "roles-diff-#{System.unique_integer([:positive])}")

    try do
      for {rel, body} <- out do
        File.write!(tmp, body)
        current = Path.join(d, rel)
        current = if File.regular?(current), do: current, else: "/dev/null"
        label = "#{Path.basename(d)}/#{rel}"
        {text, _} = System.cmd("diff", ["-u", "--label", label, "--label", label <> " (rendered)", current, tmp])
        IO.write(text)
      end
    after
      File.rm(tmp)
    end

    0
  end

  def diff(_), do: die("usage: roles diff INSTANCE")

  def render(args) do
    {flags, names} = Enum.split_with(args, &String.starts_with?(&1, "--"))
    adopt = "--adopt" in flags
    force = "--force" in flags

    for d <- instances(if names == [], do: ["all"], else: names) do
      name = Path.basename(d)
      {cls, chain, out, stale, drifted, unmanaged} = status(d)

      if drifted != [] and not force,
        do: die("#{name}: rendered files edited locally: #{Enum.join(drifted, ", ")} " <>
                  "(merge them into the template or LOCAL.md; --force overwrites)")

      if unmanaged != [] and not (adopt or force),
        do: die("#{name}: existing files differ from the render: #{Enum.join(unmanaged, ", ")} " <>
                  "(check `roles diff #{name}`, then --adopt)")

      bodies = Map.new(out)
      changed = Enum.sort(Enum.uniq(stale ++ drifted ++ unmanaged))

      for rel <- changed do
        path = Path.join(d, rel)
        File.mkdir_p!(Path.dirname(path))
        File.write!(path, bodies[rel])
      end

      old = read_lock(d)["files"] || %{}

      lock = %{
        "class" => cls,
        "chain" =>
          for(t <- chain, not t.instance,
            do: %{"template" => relpath(t.dir, workspace()), "digest" => digest_of(t.dir)}),
        "files" => Map.new(out, fn {rel, body} -> {rel, sha(body)} end)
      }

      File.write!(Path.join(d, @lock), pretty(lock) <> "\n")

      changed =
        if File.exists?(Path.join(d, "LOCAL.md")) do
          changed
        else
          File.write!(Path.join(d, "LOCAL.md"), @local_stub)
          changed ++ ["LOCAL.md (new)"]
        end

      for rel <- Enum.sort(Map.keys(old) -- Map.keys(bodies)),
          do: IO.puts("#{name}: #{rel} is no longer rendered; left in place")

      IO.puts("#{name}: " <> if(changed == [], do: "up to date", else: Enum.join(changed, ", ")))
    end

    0
  end

  def check(_args) do
    all = instances(["all"])

    bad =
      for d <- all,
          {_, _, _, stale, drifted, unmanaged} <- [status(d)],
          {kind, paths} <- [{"local edits", drifted}, {"unmanaged", unmanaged}, {"stale", stale},
                            {"not synced", unsynced(d)}],
          paths != [] do
        IO.puts("#{Path.basename(d)}: #{kind}: #{Enum.join(paths, ", ")}")
      end

    IO.puts("#{length(all)} instances, #{length(bad)} need attention")
    if bad == [], do: 0, else: 1
  end

  # ---- remote instances -------------------------------------------------------------------

  defp remote_of(d), do: load_json(Path.join(d, "instance.json"))["remote"]

  defp target(remote) do
    case Regex.run(~r/^([^\/:][^:]*):(\/.*)$/, remote) do
      [_, host, path] -> {:ssh, host, path}
      _ -> {:local, remote}
    end
  end

  defp shq(s), do: "'" <> String.replace(s, "'", "'\\''") <> "'"

  defp ssh_opts do
    extra = (System.get_env("ROLES_SSH_OPTS") || "") |> String.split(" ", trim: true)
    ["-o", "BatchMode=yes"] ++ extra
  end

  defp remote_hashes({:local, root}, files) do
    Map.new(files, fn f ->
      p = Path.join(root, f)
      {f, if(File.regular?(p), do: sha(File.read!(p)), else: nil)}
    end)
  end

  defp remote_hashes({:ssh, host, root}, files) do
    loop = Enum.map_join(files, " ", &shq/1)

    script =
      "cd #{shq(root)} 2>/dev/null || exit 0; for f in #{loop}; do " <>
        "if [ -f \"$f\" ]; then printf '%s %s\\n' \"$(shasum -a 256 < \"$f\" | cut -d' ' -f1)\" \"$f\"; fi; done"

    case System.cmd("ssh", ssh_opts() ++ [host, script], stderr_to_stdout: true) do
      {out, 0} ->
        found =
          for line <- String.split(out, "\n", trim: true), [h, f] <- [String.split(line, " ", parts: 2)],
              into: %{}, do: {f, h}

        Map.new(files, &{&1, found[&1]})

      {out, code} ->
        die("#{host}: ssh failed (exit #{code}): #{String.trim(out)}")
    end
  end

  defp push({:local, root}, mirror, files) do
    for f <- files do
      dest = Path.join(root, f)
      File.mkdir_p!(Path.dirname(dest))
      File.cp!(Path.join(mirror, f), dest)
    end
  end

  defp push({:ssh, host, root}, mirror, files) do
    remote_cmd = "mkdir -p #{shq(root)} && tar -C #{shq(root)} -xf -"

    cmd =
      "tar -C #{shq(mirror)} -cf - #{Enum.map_join(files, " ", &shq/1)} | ssh " <>
        Enum.map_join(ssh_opts(), " ", &shq/1) <> " #{shq(host)} #{shq(remote_cmd)}"

    case System.shell(cmd, stderr_to_stdout: true) do
      {_, 0} -> :ok
      {out, code} -> die("#{host}: copy failed (exit #{code}): #{String.trim(out)}")
    end
  end

  defp read_synced(d) do
    p = Path.join(d, @synced)
    if File.regular?(p), do: load_json(p), else: %{"files" => %{}}
  end

  # Rendered files whose mirror copy differs from what was last synced to the remote.
  defp unsynced(d) do
    case remote_of(d) do
      nil ->
        []

      _ ->
        synced = read_synced(d)["files"] || %{}

        for rel <- Map.keys(read_lock(d)["files"] || %{}), p <- [Path.join(d, rel)],
            not File.regular?(p) or synced[rel] != sha(File.read!(p)),
            do: rel
    end
  end

  def sync(args) do
    {flags, names} = Enum.split_with(args, &String.starts_with?(&1, "--"))
    adopt = "--adopt" in flags
    force = "--force" in flags
    targets = instances(if names == [], do: ["all"], else: names) |> Enum.filter(&remote_of/1)

    for d <- targets do
      name = Path.basename(d)
      remote = remote_of(d)
      tgt = target(remote)
      rendered = read_lock(d)["files"] || die("#{name}: render it before syncing")
      files = Enum.sort(Map.keys(rendered)) ++ ["instance.json", @lock]
      synced = read_synced(d)["files"] || %{}
      now = remote_hashes(tgt, files ++ ["LOCAL.md"])

      drifted =
        for f <- Map.keys(rendered), r <- [now[f]], r != nil, Map.has_key?(synced, f),
            r != synced[f], r != rendered[f], do: f

      unmanaged =
        for f <- Map.keys(rendered), r <- [now[f]], r != nil, not Map.has_key?(synced, f),
            r != rendered[f], do: f

      if drifted != [] and not force,
        do: die("#{name}: rendered files edited on #{remote}: #{Enum.join(Enum.sort(drifted), ", ")} " <>
                  "(merge them into the template or LOCAL.md; --force overwrites)")

      if unmanaged != [] and not (adopt or force),
        do: die("#{name}: files on #{remote} differ from the render: #{Enum.join(Enum.sort(unmanaged), ", ")} " <>
                  "(inspect them, then --adopt)")

      local_new = now["LOCAL.md"] == nil and File.regular?(Path.join(d, "LOCAL.md"))
      push(tgt, d, if(local_new, do: files ++ ["LOCAL.md"], else: files))

      record = %{"remote" => remote,
                 "files" => Map.new(files, &{&1, sha(File.read!(Path.join(d, &1)))})}

      File.write!(Path.join(d, @synced), pretty(record) <> "\n")
      IO.puts("#{name}: synced #{length(files)} files to #{remote}" <> if(local_new, do: " (LOCAL.md created)", else: ""))
    end

    0
  end

  @commands %{"list" => :list, "diff" => :diff, "render" => :render, "check" => :check,
              "sync" => :sync}

  def main([cmd | args]) when is_map_key(@commands, cmd) do
    code =
      try do
        apply(__MODULE__, @commands[cmd], [args])
      rescue
        e in Roles.Error ->
          IO.puts(:stderr, "roles: " <> e.message)
          1
      end

    System.halt(code)
  end

  def main(_) do
    IO.puts(:stderr, @usage)
    System.halt(1)
  end
end

Roles.main(System.argv())
